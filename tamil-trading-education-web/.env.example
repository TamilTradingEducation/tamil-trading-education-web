# Copy this file to .env.local and fill in real values before deploying.

# Resend (https://resend.com) — used by app/api/contact and app/api/enroll
# to email new leads to your team. Free tier covers most small business volume.
RESEND_API_KEY=

# The email address that should receive new inquiry/enrollment notifications.
LEAD_NOTIFICATION_EMAIL=info@tamiltradingeducation.com

# The "from" address Resend sends as. Must be on a domain you've verified in
# your Resend account (see https://resend.com/docs/dashboard/domains/introduction).
# Until you verify a domain, Resend's sandbox "onboarding@resend.dev" works for testing.
RESEND_FROM_EMAIL=Tamil Trading Education <onboarding@resend.dev>
